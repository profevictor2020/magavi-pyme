# Copiar a .env.prod en la VM y editar con valores reales. Nunca
# commitear .env.prod real (ver .gitignore) ni reusar valores de
# .env.example (esos son solo para desarrollo local).
#
# Uso: ver docs/DEPLOY.md.

# --- PostgreSQL ---
POSTGRES_DB=magavi
POSTGRES_USER=magavi
# Generar una contraseña real y distinta a la de cualquier otro entorno,
# ej.: openssl rand -base64 24
POSTGRES_PASSWORD=change-me-generate-a-real-password

# --- Django ---
# Generar una clave nueva, ej.:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-generate-a-real-secret-key
DJANGO_DEBUG=false
# La IP pública (o dominio, si ya se tiene uno) de la VM.
DJANGO_ALLOWED_HOSTS=change-me-vm-public-ip
# En producción el frontend y el backend quedan bajo el mismo origen
# (NGINX hace de reverse proxy, ver frontend/nginx.conf) — esto es solo
# un respaldo por si algo llama a la API directamente desde otro origen.
DJANGO_CORS_ALLOWED_ORIGINS=http://change-me-vm-public-ip
# Sin dominio + certificado TLS todavía no hay HTTPS real (ver
# docs/DEPLOY.md #6 para cuándo y cómo activarlo) — forzar el redirect
# a HTTPS sin TLS real dejaría la app inaccesible.
DJANGO_SECURE_SSL_REDIRECT=false

# --- Asistente / LLM (ver docs/DECISIONS.md ADR-004, ADR-010, ADR-014) ---
LLM_PROVIDER=ollama
LLM_OLLAMA_BASE_URL=http://llm-inference:11434
# qwen2.5:7b-instruct corre bien en la VM Always Free (4 OCPU/24GB) pero
# es lento en CPU (varios segundos por respuesta). Si se necesita algo
# más ágil para la demo, qwen2.5:3b-instruct responde más rápido a
# cambio de algo menos de calidad — ambos son 100% self-hosted (ver
# docs/DECISIONS.md ADR-004: nunca un proveedor externo en producción).
LLM_OLLAMA_MODEL=qwen2.5:7b-instruct
