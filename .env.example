# Copiar este archivo a .env y ajustar valores. Nunca commitear .env real.

# --- PostgreSQL ---
POSTGRES_DB=magavi
POSTGRES_USER=magavi
POSTGRES_PASSWORD=change-me-in-local-env

# --- Django ---
# Generar una clave nueva para cada entorno (nunca reusar esta).
DJANGO_SECRET_KEY=change-me-generate-a-real-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Asistente / LLM (ver docs/DECISIONS.md ADR-004 y ADR-010) ---
# "ollama" es el proveedor de producción (self-hosted, ver docker-compose.yml
# perfil "llm"). "deepseek_dev" es una excepción SOLO para desarrollo/pruebas
# que envía mensajes a un proveedor externo — nunca usar en producción.
LLM_PROVIDER=ollama
LLM_OLLAMA_BASE_URL=http://llm-inference:11434
LLM_OLLAMA_MODEL=qwen2.5:7b-instruct
# DEEPSEEK_API_KEY=change-me-only-for-local-dev-testing
