# Copiar este archivo a .env y ajustar valores. Nunca commitear .env real.

# --- PostgreSQL ---
POSTGRES_DB=magavi
POSTGRES_USER=magavi
POSTGRES_PASSWORD=change-me-in-local-env

# --- Django ---
# Generar una clave nueva para cada entorno (nunca reusar esta).
DJANGO_SECRET_KEY=change-me-generate-a-real-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
