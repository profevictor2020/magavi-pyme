# Variante de ./Dockerfile para Render (ver docs/DEPLOY_RENDER.md). La
# única diferencia real es el CMD: gunicorn en vez del servidor de
# desarrollo, escuchando en $PORT (Render lo inyecta en runtime, no es
# necesariamente 8000 — hay que escuchar ahí, no en un puerto fijo).
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 tesseract-ocr tesseract-ocr-spa \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements-dev.txt

COPY . .

COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["docker-entrypoint.sh"]
# Forma "shell" (sin corchetes) a propósito: es la única que expande
# $PORT en tiempo de arranque del contenedor.
CMD gunicorn config.wsgi:application --bind 0.0.0.0:$PORT --workers 2
