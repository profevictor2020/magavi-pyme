# Build de producción, servido por NGINX. A diferencia de ./Dockerfile
# (usado en desarrollo con `npm run dev`), esta imagen no incluye el
# servidor de desarrollo de Vite ni node_modules en la imagen final.
FROM node:22-slim AS build

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Se hornea en el bundle en tiempo de build (Vite), no es una variable
# de entorno leída en runtime — ver src/api/client.ts. "/api" (ruta
# relativa) funciona porque NGINX sirve el frontend y hace de reverse
# proxy hacia el backend bajo el mismo origen (ver nginx.conf) — así no
# se necesita CORS en producción.
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
RUN npm run build

FROM nginx:1.27-alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
